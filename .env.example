# Copy to .env and fill in. Never commit .env.

# --- Telegram -----------------------------------------------------------
# Create a bot with @BotFather, then message it once so it can see your chat.
# `python mastery.py check` will tell you if the chat id is wrong.
MASTERY_TELEGRAM_BOT_TOKEN=
MASTERY_TELEGRAM_CHAT_ID=

# --- Supabase -----------------------------------------------------------
# Project Settings -> API. The URL is public; the secret key is not.
# Use the secret key (sb_secret_... or the legacy service_role JWT) — the anon
# key cannot read these tables, which is the point.
MASTERY_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
MASTERY_SUPABASE_SERVICE_KEY=

# --- Anthropic ----------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Optional -----------------------------------------------------------
# Any current model works. Opus gives the sharpest questions and the most
# useful grading; Sonnet costs roughly a third as much.
MASTERY_MODEL=claude-opus-5

# The language the examiner writes in. Anything Claude speaks.
MASTERY_LANGUAGE=English

# How many questions per day.
MASTERY_QUESTIONS_PER_DAY=5

# The file describing what you are studying against. See context.example.md.
MASTERY_CONTEXT_FILE=context.md
